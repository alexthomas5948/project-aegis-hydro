# ==============================================================================
# AEGIS-KERALA COMMAND CENTER - SECURE BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# IMPORTANT: These variables are locked on the Vercel backend and NEVER exposed
# to the browser client bundle. Add them in Vercel Dashboard -> Project Settings -> Environment Variables.

# Emergency Outbound Webhook Gateway Secret
DISPATCH_WEBHOOK_URL="https://your-emergency-gateway.internal/webhook"
DISPATCH_WEBHOOK_SECRET="replace-with-secure-hmac-sha256-key"

# State Disaster Management Authority / Telecom Gateway (Optional)
KSDMA_GATEWAY_TOKEN="replace-with-ksdma-cap-token"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Commercial Hydro-Meteorological / ECMWF API (Optional, defaults to open tier)
OPENMETEO_API_KEY=""

# Supabase Realtime Service Role (Optional, locked on backend)
SUPABASE_SERVICE_ROLE_KEY=""
